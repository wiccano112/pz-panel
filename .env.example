# ==========================================
# Project Zomboid Panel Environment Config
# ==========================================

# Steam Web API Key (for Build 42 dynamic Workshop search)
# Get a free key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Server Directory on Host Machine (where docker-compose.yml lives)
PZ_SERVER_DIR=/opt/pz-server

# Project Zomboid Server / Save Name (corresponds to ServerName.ini and ServerName.db)
PZ_SERVER_NAME=servertest

# Docker Container Name
PZ_DOCKER_CONTAINER=pz-server
